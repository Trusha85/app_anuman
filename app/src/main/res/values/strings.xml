    <!-- About Screen -->
    <string name="about_title">About App-Anuman Security</string>
    <string name="about_quote">“An app that audits security must pass its own audit.”</string>
    <string name="about_self_score">Self-Audit Score: %1$d/100 (LOW Band ✅)</string>
    <string name="about_self_desc">App-Anuman appears in its own audit results and scores below 10 with 0 dangerous permissions.</string>

    <string name="about_perms_title">Permissions We Use</string>
    <string name="about_perms_desc">QUERY_ALL_PACKAGES to inventory installed apps, and PACKAGE_USAGE_STATS to detect dormant threats. Zero INTERNET permission.</string>

    <string name="about_storage_title">Data Stored on Device</string>
    <string name="about_storage_desc">Language and mode preferences, plus encrypted permission snapshots for update creep detection. All scan data is in-memory only.</string>

    <string name="about_online_title">Data Sent Online</string>
    <string name="about_online_desc">Nothing. Ever. App-Anuman contains zero network libraries and makes zero outbound connections.</string>

    <string name="about_security_title">Security Hardening</string>
    <string name="about_security_desc">FLAG_SECURE active (prevents screenshots/screen recordings), debuggable=false, allowBackup=false, cleartextTrafficPermitted=false.</string>

