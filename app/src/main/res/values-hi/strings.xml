    <!-- About Screen -->
    <string name="about_title">ऐप-अनुमान सुरक्षा के बारे में</string>
    <string name="about_quote">“जो ऐप सुरक्षा का ऑडिट करता है, उसे अपने स्वयं के ऑडिट में पास होना चाहिए।”</string>
    <string name="about_self_score">सेल्फ-ऑडिट स्कोर: %1$d/100 (कम जोखिम ✅)</string>
    <string name="about_self_desc">ऐप-अनुमान अपने स्वयं के ऑडिट परिणामों में दिखाई देता है और 0 खतरनाक अनुमतियों के साथ 10 से कम स्कोर करता है।</string>

    <string name="about_perms_title">हम कौन सी अनुमतियों का उपयोग करते हैं</string>
    <string name="about_perms_desc">स्थापित ऐप्स की सूची के लिए QUERY_ALL_PACKAGES, और निष्क्रिय खतरों का पता लगाने के लिए PACKAGE_USAGE_STATS। इंटरनेट की अनुमति शून्य है।</string>

    <string name="about_storage_title">डिवाइस पर संग्रहीत डेटा</string>
    <string name="about_storage_desc">भाषा और मोड प्राथमिकताएं, साथ ही अपडेट अंतर का पता लगाने के लिए एन्क्रिप्टेड अनुमति स्नैपशॉट। सभी स्कैन केवल मेमोरी में होते हैं।</string>

    <string name="about_online_title">ऑनलाइन भेजा गया डेटा</string>
    <string name="about_online_desc">कुछ भी नहीं। कभी नहीं। ऐप-अनुमान में कोई नेटवर्क लाइब्रेरी नहीं है और कोई बाहरी कनेक्शन नहीं बनता।</string>

    <string name="about_security_title">सुरक्षा उपाय</string>
    <string name="about_security_desc">FLAG_SECURE सक्रिय (स्क्रीनशॉट और स्क्रीन रिकॉर्डिंग रोकता है), debuggable=false, allowBackup=false, cleartextTrafficPermitted=false।</string>

    <string name="about_version_title">इंजन और बिल्ड</string>
